{
  "manifest_version": 3,
  "name": "Lambda OS",
  "version": "0.15.2",
  "description": "DC Ops command center for Lambda: sites, tickets, deployments, inventory and alerts from NetBox, Jira, Slack, Grafana and more.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Open Lambda OS",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "declarativeNetRequestWithHostAccess",
    "notifications"
  ],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "https://netbox.prod.lambdalabs.cloud/*",
    "https://app.slack.com/*",
    "https://mail.google.com/*",
    "https://calendar.google.com/*",
    "https://*.app.netsuite.com/*",
    "https://kelsier.aws.lambdalabs.cloud/*",
    "https://grafana.aws.lambdalabs.cloud/*",
    "https://yard-central.aws.lambdalabs.cloud/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://lambda.com/*"
  ],
  "optional_permissions": [
    "management"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}