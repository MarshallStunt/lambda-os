{
  "manifest_version": 3,
  "name": "Lambda OS",
  "version": "0.7.9",
  "description": "Ops command center for Lambda: sites, inventory, tickets, projects and deployments from NetBox, Jira, NetSuite, Slack, Gmail and Calendar.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Open Lambda OS",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "notifications"
  ],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "https://netbox.prod.lambdalabs.cloud/*",
    "https://app.slack.com/*",
    "https://mail.google.com/*",
    "https://calendar.google.com/*",
    "https://*.app.netsuite.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}